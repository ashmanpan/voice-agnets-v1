# Twilio Configuration
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# OpenAI Configuration (for Whisper STT and TTS)
OPENAI_API_KEY=your_openai_api_key_here

# Groq Configuration (for ultra-fast AI conversations - RECOMMENDED)
GROQ_API_KEY=your_groq_api_key_here

# Google Cloud Configuration (Optional - if using Google TTS instead of OpenAI TTS)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-credentials.json

# Database Configuration
DATABASE_URL=postgresql://voiceagent:voiceagent@db:5432/voiceagent

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_URL=https://your-ngrok-url.ngrok.io

# TTS Provider (openai or google)
TTS_PROVIDER=openai

# Recording Storage
RECORDINGS_PATH=./recordings

# API key required for mutating /api requests (X-API-Key header). Set a strong secret.
API_KEY=change-me-to-a-strong-secret

# Comma-separated allowed browser origins for CORS (frontend dev server, prod domain)
CORS_ORIGINS=http://localhost:5173

# Max call-trigger POSTs per API key per window (seconds)
CALL_RATE_LIMIT=10
CALL_RATE_WINDOW=60

# Pipeline: cascade (STT->LLM->TTS, default) or realtime (OpenAI speech-to-speech)
PIPELINE_MODE=cascade
REALTIME_VOICE=alloy

# MCP tool servers for mid-call tool use (comma-separated base URLs; empty = none)
MCP_SERVERS=

# Telephony: LiveKit SIP is primary. Set false to disable legacy Twilio TwiML webhooks.
ENABLE_TWILIO_WEBHOOKS=true
