# LiveKit Cloud Configuration
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Groq AI Configuration (via OpenAI-compatible API)
OPENAI_API_KEY=your-groq-api-key
GROQ_API_KEY=your-groq-api-key

# Deepgram STT Configuration
DEEPGRAM_API_KEY=your-deepgram-api-key

# Optional: Twilio for telephony integration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Voice provider selection (default openai). TTS_PROVIDER=elevenlabs to use ElevenLabs.
TTS_PROVIDER=openai
STT_PROVIDER=openai
# ElevenLabs (only needed when TTS_PROVIDER=elevenlabs)
ELEVEN_API_KEY=
ELEVEN_MODEL=eleven_flash_v2_5
ELEVEN_VOICE_ID=

# Pipeline: cascade (STT->LLM->TTS, default) or realtime (OpenAI speech-to-speech)
PIPELINE_MODE=cascade
REALTIME_VOICE=alloy
